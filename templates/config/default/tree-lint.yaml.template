---
roots:
- src
ignore:
- node_modules
- dist
- build
entities:
  component:
    matches:
      type: directory
      name: "[A-Z]*"
      children:
      - type: file
        name: "*.tsx"
      - type: file
        name: index.ts
    rules:
      name:
        type: error
        pattern: "[A-Z]*"
      childrenAmount:
        type: warning
        max: 6
      children:
      - _matches:
          type: file
          name: "*.tsx"
        lineCount:
          type: warning
          max: 200
  hook:
    matches:
      type: file
      name: use*.{ts,tsx}
    rules:
      name:
        type: error
        pattern: use*
      lineCount:
        type: warning
        max: 80
  page:
    matches:
      type: directory
      name: "[A-Z]*"
      children:
      - type: file
        name: "*.tsx"
    rules:
      name:
        type: error
        pattern: "[A-Z]*"
      childrenAmount:
        type: warning
        max: 8
  util:
    matches:
      type: file
      name: "*.{ts,js}"
    rules:
      name:
        type: error
        pattern: "[a-z]*"
      lineCount:
        type: warning
        max: 60
  service:
    matches:
      type: file
      name: "*.service.ts"
    rules:
      name:
        type: error
        pattern: "[a-z]*.service.ts"
      lineCount:
        type: warning
        max: 200
  context:
    matches:
      type: file
      name: "*Context.tsx"
    rules:
      name:
        type: error
        pattern: "[A-Z]*Context.tsx"
      lineCount:
        type: warning
        max: 150
  typeFile:
    matches:
      type: file
      name: "*.types.ts"
    rules:
      name:
        type: error
        pattern: "[a-z]*.types.ts"
      lineCount:
        type: warning
        max: 80
layers:
  components:
    entities:
    - component
    rules:
      childrenAmount:
        type: warning
        max: 20
  hooks:
    entities:
    - hook
  pages:
    entities:
    - page
  utils:
    entities:
    - util
  services:
    entities:
    - service
  context:
    entities:
    - context
  types:
    entities:
    - typeFile
