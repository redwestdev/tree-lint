{
  "roots": [
    "src"
  ],
  "ignore": [
    "node_modules",
    "dist",
    "build"
  ],
  "groups": {
    "matches": {
      "type": "directory",
      "name": "[a-z]*"
    },
    "rules": {
      "nameLength": {
        "type": "warning",
        "max": 20
      }
    }
  },
  "entities": {
    "page": {
      "matches": {
        "type": "directory",
        "name": "[A-Z]*{Pg,Page}",
        "children": [
          {
            "type": "file",
            "name": "*.tsx"
          },
          {
            "type": "file",
            "name": "index.ts"
          }
        ]
      },
      "rules": {
        "name": {
          "type": "error",
          "pattern": "[A-Z]*{Pg,Page}"
        },
        "nameLength": {
          "type": "warning",
          "min": 6,
          "max": 20
        },
        "childrenAmount": {
          "type": "warning",
          "max": 12
        },
        "children": [
          {
            "matches": {
              "type": "file",
              "name": "*.tsx"
            },
            "lineCount": {
              "type": "warning",
              "max": 100
            }
          }
        ]
      }
    },
    "section": {
      "matches": {
        "type": "directory",
        "name": "[A-Z]*{Sct,Section}",
        "children": [
          {
            "type": "file",
            "name": "*.tsx"
          },
          {
            "type": "file",
            "name": "index.ts"
          }
        ]
      },
      "rules": {
        "name": {
          "type": "error",
          "pattern": "[A-Z]*{Sct,Section}"
        },
        "nameLength": {
          "type": "warning",
          "min": 5,
          "max": 20
        },
        "children": [
          {
            "matches": {
              "type": "file",
              "name": "*.tsx"
            },
            "lineCount": {
              "type": "warning",
              "max": 150
            }
          }
        ]
      }
    },
    "component": {
      "matches": {
        "type": "directory",
        "name": "[A-Z]*",
        "children": [
          {
            "type": "file",
            "name": "*.tsx"
          },
          {
            "type": "file",
            "name": "index.ts"
          }
        ]
      },
      "rules": {
        "name": {
          "type": "error",
          "pattern": "[A-Z]*"
        },
        "nameLength": {
          "type": "warning",
          "min": 3,
          "max": 20
        },
        "childrenAmount": {
          "type": "warning",
          "max": 8
        },
        "children": [
          {
            "matches": {
              "type": "file",
              "name": "*.tsx"
            },
            "lineCount": {
              "type": "warning",
              "max": 200
            }
          }
        ]
      }
    },
    "manager": {
      "matches": {
        "type": "directory",
        "name": "[A-Z]*{Mng,Manager}",
        "children": [
          {
            "type": "file",
            "name": "*.tsx"
          },
          {
            "type": "file",
            "name": "index.ts"
          }
        ]
      },
      "rules": {
        "name": {
          "type": "error",
          "pattern": "[A-Z]*{Mng,Manager}"
        },
        "nameLength": {
          "type": "warning",
          "min": 5,
          "max": 20
        }
      }
    },
    "hook": {
      "matches": {
        "type": "file",
        "name": "use*.{ts,tsx}"
      },
      "rules": {
        "name": {
          "type": "error",
          "pattern": "use*"
        },
        "lineCount": {
          "type": "warning",
          "max": 80
        }
      }
    },
    "util": {
      "matches": {
        "type": "file",
        "name": "*.ts"
      },
      "rules": {
        "name": {
          "type": "error",
          "pattern": "[a-z]*"
        },
        "lineCount": {
          "type": "warning",
          "max": 60
        }
      }
    }
  },
  "layers": {
    "pages": {
      "entities": [
        "page"
      ]
    },
    "sections": {
      "entities": [
        "section"
      ]
    },
    "components": {
      "entities": [
        "component"
      ],
      "rules": {
        "childrenAmount": {
          "type": "warning",
          "max": 20
        }
      }
    },
    "hooks": {
      "entities": [
        "hook"
      ]
    },
    "utils": {
      "entities": [
        "util"
      ]
    },
    "managers": {
      "entities": [
        "manager"
      ],
      "rules": {
        "childrenAmount": {
          "type": "warning",
          "max": 10
        }
      }
    }
  }
}
