{
  "name": "tree-lint",
  "version": "1.0.0",
  "main": "dist/index.js",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tree-lint": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write .",
    "scan": "node dist/cli.js scan"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.55.0",
    "@typescript-eslint/types": "^8.55.0",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "cosmiconfig": "^9.0.0",
    "fast-glob": "^3.3.3",
    "filesize": "^11.0.13",
    "jiti": "^2.6.1",
    "lodash.merge": "^4.6.2",
    "micromatch": "^4.0.8",
    "ora": "^9.3.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^25.2.3",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "prettier": "3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.0.18"
  }
}
